# Copy to .env and fill in real values: `cp .env.example .env`
# Used by docker-compose.yml. The .env file is gitignored.

# Required. Postgres superuser password / used in the DB connection string.
POSTGRES_PASSWORD=

# Required. Secret used by better-auth to sign sessions. Use a long random value,
# e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Optional (these have sensible localhost defaults).
# BETTER_AUTH_URL=http://localhost:3000
# TRUSTED_ORIGINS=http://localhost:5173
