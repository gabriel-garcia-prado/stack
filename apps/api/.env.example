# Local (non-Docker) dev config for the API. Bun auto-loads this file.
# POSTGRES_PASSWORD must match the one in the root .env that starts Postgres.
POSTGRES_PASSWORD='my_password'
BETTER_AUTH_SECRET='random_string'
BETTER_AUTH_URL='http://localhost:3000'
TRUSTED_ORIGINS='http://localhost:5173'

# Optional: a full URL here overrides the assembled one (managed/hosted DB).
# DATABASE_CONNECTION_STRING='postgresql://user:pass@host:5432/db'
