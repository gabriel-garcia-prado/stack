{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@factory": ["./apps/api/src/factory.ts"],
      "@appResponse": ["./apps/api/src/lib/app-response.ts"],
      "@validator": ["./apps/api/src/middleware/validator.ts"],
      "@errors": ["./apps/api/src/types/errors.ts"],
      "@database": ["./apps/api/src/database.ts"],
      "@environment": ["./apps/api/src/types/environment.ts"],
      "@testHelpers": ["./apps/api/src/lib/test.ts"],
      "@dbSchema": ["./apps/api/drizzle/schema/index.ts"],
      "@/*": ["./apps/web/src/*"]
    }
  }
}
